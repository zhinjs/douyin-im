{
    "name": "douyin-im",
    "version": "1.0.0",
    "type": "module",
    "description": "TypeScript SDK for Douyin private messages and group chats",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./protocol": {
            "types": "./lib/protocol.d.ts",
            "import": "./lib/protocol.js"
        },
        "./base": {
            "types": "./lib/base/index.d.ts",
            "import": "./lib/base/index.js"
        }
    },
    "files": [
        "lib",
        "README.md",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "prebuild": "pnpm run clean",
        "build": "tsc && node scripts/build/copy-proto.mjs && node scripts/build/browser-bdms.mjs",
        "demo": "tsx demo.ts",
        "typecheck:demo": "tsc -p tsconfig.demo.json",
        "clean": "rm -rf lib",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
        "lint": "eslint \"src/**/*.ts\" \"demo.ts\" \"demo/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"demo.ts\" \"demo/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"demo.ts\" \"demo/**/*.ts\"",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "prepack": "pnpm run build"
    },
    "keywords": [
        "douyin",
        "im",
        "typescript",
        "nodejs"
    ],
    "author": "Zhin.js",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhinjs/douyin-im.git"
    },
    "homepage": "https://github.com/zhinjs/douyin-im#readme",
    "bugs": {
        "url": "https://github.com/zhinjs/douyin-im/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@zhin.js/logger": "^1.1.0",
        "protobufjs": "^8.4.2",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@types/jest": "^29.5.8",
        "@types/node": "^22.20.2",
        "@types/qrcode": "^1.5.6",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "crypto-js": "4.2.0",
        "eslint": "^8.54.0",
        "jest": "^29.7.0",
        "jsencrypt": "3.5.4",
        "prettier": "^3.1.0",
        "qrcode": "^1.5.4",
        "ts-jest": "^29.1.1",
        "tsx": "^4.22.3",
        "typescript": "^5.3.2"
    },
    "engines": {
        "node": ">=22.5.0"
    },
    "packageManager": "pnpm@9.0.2+sha512.8bedf31de42705b97ff89330bbe177954ad5703a92fa894be0fb4d45b5dfab59a21f65a8419ad1cae82dd16fac2d41a8c343775e80efe7dab6d80b0408db2fd6"
}
